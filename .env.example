# 复制成 .env 后按需改。

# 网关的 api key（也是后台登录那把钥匙）。镜像里不带它：密钥是申请来的，
# 写在这里它只落在宿主机上。多把用逗号隔开：
#   MMXCODE_API_KEYS=sk-xxxx,sk-yyyy
# 不设的话，容器里的网关只肯听本机 —— 它监听所有网卡，没有 key 就等于
# 白送出去，所以它会报错退出。
MMXCODE_API_KEYS=

# 导入用的密码加密的密钥（base64 的 32 字节）。不设就不存密码。
# 生成：head -c 32 /dev/urandom | base64
MMXCODE_PASSWORD_KEY=

# 数据目录的挂载源（宿主机侧）。
# 默认 mmxcode-data = Docker 命名卷：Docker 按镜像里 /data 的属主（uid 10001）
# 创建它，容器里的 mmxcode 用户（uid 10001）能直接读写，数据库落在
# /data/mmxcode.db。
# 想把数据库留在宿主机目录上就写 MMXCODE_DATA_DIR=./data（相对路径按 compose
# 文件所在目录解析）。注意：宿主机那个目录必须对 uid 10001 可写，否则容器
# 建不了数据库文件、启动即失败：
#   mkdir -p data && chown 10001:10001 data
MMXCODE_DATA_DIR=

# 挂进容器的配置文件（宿主机路径）。
# 默认用仓库自带的 config.docker.yaml；要改成自己的副本就写绝对路径，
# 例如 MMXCODE_CONFIG_FILE=./config.yaml（相对路径按 compose 文件所在目录解析）。
MMXCODE_CONFIG_FILE=

# 容器内走宿主机的代理。要用别的出口就改这里。
# 默认 http://host.docker.internal:7890（容器里访问宿主机的代理要写
# host.docker.internal，compose 里已经配好）。
MMXCODE_PROXY_DEFAULT=

# 打开 WARP 出口：把下面这行的注释去掉，compose 才会起 WARP 那个容器。
# 默认是关的 —— 下面这行保持注释，普通的 docker compose up 就不会启动 WARP。
# 打开时（取消注释）宿主机的 /dev/net/tun 要可用，容器需要 NET_ADMIN。
# COMPOSE_PROFILES=warp
