# 隔离工作区
.worktrees/

# 本地数据库与 WAL 文件
*.db
*.db-wal
*.db-shm

# 本地配置
config.yaml
.env

# 导出来的账号清单：里面有明文密码，不进版本库
accounts-export.txt

# 编译出来的二进制和运行日志
/mmxcode.exe
/mmxcode.exe~
/serve.log

# 审查临时目录
.tmp-review/

# 差分测试用的临时探针
.scratch-probe/

# Python 的缓存（计划检查的脚本留下的）
__pycache__/

# 发布包
dist/

# 预览用的临时服务（不进版本库）
/cmd/previewtmp/
previewtmp.exe
